{
  "name": "Full Screen Menus",
  "author": "dankutron9000",
  "version": "v1.5.3",
  "description": "Extends the QAM and Main Menus to the bottom of the screen. Adds adjustable width controls for both menus and an option to keep the Main Menu expanded while in-game.",
  "target": "Tweak",
  "manifest_version": 8,
  "inject": {
    "bigpicture.css": [
      "bigpicture"
    ],
    "full_width_mainmenu.css": [
      "MainMenu"
    ],
    "full_width_qam.css": [
      "QuickAccess"
    ]
  },
  "patches": {
    "Main Menu Width": {
      "default": "Off",
      "type": "slider",
      "values": {
        "Off": {
          "--main-menu-width": [
            "240px",
            "bigpicture",
            "MainMenu"
          ]
        },
        "50%": {
          "--main-menu-width": [
            "50vw",
            "bigpicture",
            "MainMenu"
          ]
        },
        "75%": {
          "--main-menu-width": [
            "75vw",
            "bigpicture",
            "MainMenu"
          ]
        },
        "100%": {
          "--main-menu-width": [
            "100vw",
            "bigpicture",
            "MainMenu"
          ]
        }
      }
    },
    "QAM Width": {
      "default": "Off",
      "type": "slider",
      "values": {
        "Off": {
          "--qam-width": [
            "348px",
            "bigpicture"
          ]
        },
        "50%": {
          "--qam-width": [
            "50vw",
            "bigpicture"
          ]
        },
        "75%": {
          "--qam-width": [
            "75vw",
            "bigpicture"
          ]
        },
        "100%": {
          "--qam-width": [
            "100vw",
            "bigpicture"
          ]
        }
      }
    },
    "Expand Menu In Game": {
      "default": "No",
      "type": "dropdown",
      "values": {
        "No": {
          "--main-menu-ingame-width": [
            "240px",
            "MainMenu"
          ]
        },
        "Yes": {
          "--main-menu-ingame-width": [
            "var(--main-menu-width)",
            "MainMenu"
          ]
        }
      }
    }
  }
}
